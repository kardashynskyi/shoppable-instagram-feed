<div
  class="sig-feed"
  data-sig-feed
  data-shop="{{ shop.permanent_domain | escape }}"
  data-limit="{{ block.settings.limit }}"
  data-columns="{{ block.settings.columns }}"
  data-api-url="https://shoppable-instagram-feed.onrender.com/api/instagram-feed"
>
  <div class="sig-feed__header">
    <div class="sig-feed__heading-group">
      {% if block.settings.eyebrow != blank %}
        <p class="sig-feed__eyebrow">
          {{ block.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if block.settings.heading != blank %}
        <h2 class="sig-feed__heading">
          {{ block.settings.heading | escape }}
        </h2>
      {% endif %}
    </div>
  </div>

  <div class="sig-feed__carousel">
    <button
      type="button"
      class="sig-feed__floating-arrow sig-feed__floating-arrow--previous"
      aria-label="Show previous Instagram posts"
      hidden
      data-sig-floating-previous
    >
      <svg
        class="sig-feed__chevron"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M14.5 5.5 8 12l6.5 6.5" />
      </svg>
    </button>

    <div
      class="sig-feed__viewport"
      data-sig-viewport
    >
      <div
        class="sig-feed__track"
        id="sig-feed-{{ block.id }}"
        aria-live="polite"
        data-sig-track
        aria-busy="true"
      >
        <div
          class="sig-feed__skeleton"
          aria-hidden="true"
          data-sig-skeleton
        >
          {% for i in (1..6) %}
            <div class="sig-feed__skeleton-item"></div>
          {% endfor %}
        </div>
      </div>
    </div>

    <button
      type="button"
      class="sig-feed__floating-arrow"
      aria-label="Show more Instagram posts"
      hidden
      data-sig-floating-next
    >
      <svg
        class="sig-feed__chevron"
        viewBox="0 0 24 24"
        aria-hidden="true"
        focusable="false"
      >
        <path d="m9.5 5.5 6.5 6.5-6.5 6.5" />
      </svg>
    </button>
  </div>
</div>

<script>
  (() => {
    const script = document.currentScript;
    const section = script?.previousElementSibling;

    if (!section || !section.matches("[data-sig-feed]")) {
      return;
    }

    const track = section.querySelector("[data-sig-track]");
    const viewport = section.querySelector("[data-sig-viewport]");
    const floatingPreviousButton = section.querySelector(
      "[data-sig-floating-previous]"
    );
    const floatingNextButton = section.querySelector(
      "[data-sig-floating-next]"
    );

    const shop = section.dataset.shop;
    const limit = Number(section.dataset.limit || 30);
    const configuredColumns = Number(
      section.dataset.columns || 6
    );
    const apiUrl = section.dataset.apiUrl;

    if (
      !track ||
      !viewport ||
      !shop ||
      !apiUrl
    ) {
      return;
    }

    let currentIndex = 0;
    let posts = [];
    let resizeTimer;

    const escapeHtml = (value) => {
      return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    };

    const safeUrl = (value) => {
      if (!value) {
        return "";
      }

      try {
        const url = new URL(
          value,
          window.location.origin
        );

        if (
          url.protocol !== "http:" &&
          url.protocol !== "https:"
        ) {
          return "";
        }

        return url.href;
      } catch {
        return "";
      }
    };

    const buildHref = (post) => {
      const tag =
        Array.isArray(post.tags) &&
        post.tags.length > 0
          ? post.tags[0]
          : null;

      if (tag?.productHandle) {
        return (
          `/products/` +
          encodeURIComponent(
            tag.productHandle
          )
        );
      }

      if (tag?.collectionHandle) {
        return (
          `/collections/` +
          encodeURIComponent(
            tag.collectionHandle
          )
        );
      }

      return safeUrl(post.permalink) || "#";
    };

    const getVisibleCount = () => {
      const width = window.innerWidth;

      if (width <= 560) {
        return 1;
      }

      if (width <= 768) {
        return 2;
      }

      if (width <= 1100) {
        return 3;
      }

      return Math.max(
        3,
        Math.min(configuredColumns, 6)
      );
    };

    const getGap = () => {
      const styles =
        window.getComputedStyle(track);

      return (
        Number.parseFloat(
          styles.columnGap ||
          styles.gap ||
          "0"
        ) || 0
      );
    };

    const getMaximumIndex = () => {
      return Math.max(
        0,
        posts.length - getVisibleCount()
      );
    };



    const updateButtonStates = () => {
      const hasOverflow =
        posts.length > getVisibleCount();

      const isAtStart =
        currentIndex <= 0;

      const isAtEnd =
        currentIndex >= getMaximumIndex();

      if (floatingPreviousButton) {
        floatingPreviousButton.disabled =
          isAtStart;

        floatingPreviousButton.hidden =
          !hasOverflow || isAtStart;
      }

      if (floatingNextButton) {
        floatingNextButton.disabled =
          isAtEnd;

        floatingNextButton.hidden =
          !hasOverflow || isAtEnd;
      }
    };

    const updateCarousel = ({
      smooth = true
    } = {}) => {
      const firstTile =
        track.querySelector(
          ".sig-feed__item"
        );

      if (!firstTile) {
        return;
      }

      const maximumIndex =
        getMaximumIndex();

      currentIndex =
        Math.max(
          0,
          Math.min(
            currentIndex,
            maximumIndex
          )
        );

      const tileWidth =
        firstTile.getBoundingClientRect()
          .width;

      const distance =
        currentIndex *
        (tileWidth + getGap());

      track.style.transition =
        smooth
          ? "transform 420ms cubic-bezier(0.22, 1, 0.36, 1)"
          : "none";

      track.style.transform =
        `translate3d(-${distance}px, 0, 0)`;

      updateButtonStates();
    };



    const movePrevious = () => {
      currentIndex =
        Math.max(
          0,
          currentIndex -
            Math.max(
              1,
              getVisibleCount() - 1
            )
        );

      updateCarousel();
    };

    const moveNext = () => {
      currentIndex =
        Math.min(
          getMaximumIndex(),
          currentIndex +
            Math.max(
              1,
              getVisibleCount() - 1
            )
        );

      updateCarousel();
    };

    const renderPost = (
      post,
      index
    ) => {
      const mediaUrl =
        safeUrl(post.mediaUrl);

      if (!mediaUrl) {
        return "";
      }

      const href =
        buildHref(post);

      const caption =
        escapeHtml(
          post.caption ||
          "Instagram post"
        );

      const hasTag =
        Array.isArray(post.tags) &&
        post.tags.length > 0;

      const linkAttributes =
        href === "#"
          ? 'aria-disabled="true" tabindex="-1"'
          : hasTag
            ? 'target="_self"'
            : 'target="_blank" rel="noopener noreferrer"';

      const media =
        post.mediaType === "VIDEO"
          ? `
            <video
              src="${escapeHtml(mediaUrl)}"
              muted
              loop
              playsinline
              autoplay
              preload="metadata"
              aria-label="${caption}"
            ></video>
          `
          : `
            <img
              src="${escapeHtml(mediaUrl)}"
              alt="${caption}"
              loading="${index < 6 ? "eager" : "lazy"}"
              fetchpriority="${index < 6 ? "high" : "auto"}"
              decoding="async"
              width="1200"
              height="1200"
            >
          `;

      return `
        <article
          class="sig-feed__slide"
          aria-label="Instagram post ${index + 1}"
        >
          <a
            class="sig-feed__item"
            href="${escapeHtml(href)}"
            ${linkAttributes}
          >
            <div class="sig-feed__media">
              ${media}
            </div>

            <div class="sig-feed__overlay">
              <div class="sig-feed__overlay-content">
                <span class="sig-feed__action">
                  ${
                    hasTag
                      ? "Shop this post"
                      : "View on Instagram"
                  }

                  <span aria-hidden="true">↗</span>
                </span>
              </div>
            </div>

            ${
              hasTag
                ? `
                  <span class="sig-feed__badge">
                    <span
                      class="sig-feed__heart-icon"
                      aria-hidden="true"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        focusable="false"
                      >
                        <path
                          d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>

                    <span class="sig-feed__badge-text">
                      Shop now
                    </span>
                  </span>
                `
                : ""
            }
          </a>
        </article>
      `;
    };

    const setLoadingState = (
      isLoading
    ) => {
      track.setAttribute(
        "aria-busy",
        String(isLoading)
      );
    };

    const showMessage = (
      message
    ) => {
      setLoadingState(false);

      track.innerHTML = `
        <p class="sig-feed__message">
          ${escapeHtml(message)}
        </p>
      `;

      if (floatingPreviousButton) {
        floatingPreviousButton.hidden = true;
      }

      if (floatingNextButton) {
        floatingNextButton.hidden = true;
      }
    };

    floatingPreviousButton?.addEventListener(
      "click",
      movePrevious
    );

    floatingNextButton?.addEventListener(
      "click",
      moveNext
    );

    section.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "ArrowLeft") {
          movePrevious();
        }

        if (event.key === "ArrowRight") {
          moveNext();
        }
      }
    );

    window.addEventListener(
      "resize",
      () => {
        clearTimeout(resizeTimer);

        resizeTimer = setTimeout(
          () => {
            updateCarousel({
              smooth: false
            });
          },
          120
        );
      }
    );

    fetch(
      `${apiUrl}?shop=${encodeURIComponent(shop)}`,
      {
        method: "GET",
        headers: {
          Accept: "application/json"
        }
      }
    )
      .then((response) => {
        if (!response.ok) {
          throw new Error(
            `Feed request failed with status ${response.status}`
          );
        }

        return response.json();
      })
      .then((data) => {
        posts = Array.isArray(data.posts)
          ? data.posts.slice(
              0,
              Math.max(1, limit)
            )
          : [];

        if (!posts.length) {
          showMessage(
            "No Instagram posts found."
          );

          return;
        }

        const markup = posts
          .map(renderPost)
          .filter(Boolean)
          .join("");

        if (!markup) {
          showMessage(
            "No Instagram media available."
          );

          return;
        }

        setLoadingState(false);
        track.innerHTML = markup;

        requestAnimationFrame(() => {
          updateCarousel({
            smooth: false
          });
        });
      })
      .catch((error) => {
        console.error(
          "Shoppable Instagram Feed error:",
          error
        );

        showMessage(
          "Instagram feed could not be loaded."
        );
      });
  })();
</script>

<style>
  .sig-feed {
    --sig-gap:
      {{ block.settings.gap }}px;
    --sig-columns:
      {{ block.settings.columns }};
    --sig-radius:
      {{ block.settings.image_radius }}px;

    position: relative;
    width: min(
      calc(100% - 40px),
      {{ block.settings.width }}px
    );
    max-width:
      {{ block.settings.width }}px;
    margin: 0 auto;
    padding:
      {{ block.settings.padding_top }}px
      0
      {{ block.settings.padding_bottom }}px;

    font-family:
      var(--font-body-family, inherit);
    font-style:
      var(--font-body-style, normal);
    font-weight:
      var(--font-body-weight, 400);

    {% if block.settings.use_custom_background %}
      background:
        {{ block.settings.background_color }};
      box-shadow:
        0 0 0 100vmax
        {{ block.settings.background_color }};
      clip-path:
        inset(0 -100vmax);
    {% endif %}
  }

  .sig-feed__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 30px;
  }

  .sig-feed__heading-group {
    min-width: 0;
  }

  .sig-feed__eyebrow {
    margin: 0 0 10px;
    font-family:
      var(--font-body-family, inherit);
    font-style:
      var(--font-body-style, normal);
    font-weight:
      var(--font-body-weight, 400);
    font-size: 13px;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .sig-feed__heading {
    margin: 0;
    font-family:
      var(--font-heading-family, inherit);
    font-style:
      var(--font-heading-style, normal);
    font-weight:
      var(--font-heading-weight, 400);
    font-size:
      {{ block.settings.heading_size }}px;
    line-height: 1.04;
    letter-spacing: -0.04em;
  }





  .sig-feed__floating-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 1px solid
      rgba(17, 17, 17, 0.16);
    border-radius: 50%;
    background:
      rgba(255, 255, 255, 0.92);
    color: #111111;
    font: inherit;
    font-size: 21px;
    line-height: 1;
    cursor: pointer;
    box-shadow:
      0 6px 18px
      rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(12px);
    transition:
      transform 180ms ease,
      background 180ms ease,
      opacity 180ms ease,
      box-shadow 180ms ease;
  }

  .sig-feed__floating-arrow:hover {
    transform: translateY(-2px);
    background: #ffffff;
    box-shadow:
      0 10px 26px
      rgba(0, 0, 0, 0.13);
  }

  .sig-feed__floating-arrow:disabled {
    opacity: 0.3;
    cursor: default;
    transform: none;
    box-shadow: none;
  }

  .sig-feed__carousel {
    position: relative;
  }

  .sig-feed__viewport {
    width: 100%;
    overflow: hidden;
    padding:
      18px
      0
      24px;
    margin:
      -18px
      0
      -24px;
  }

  .sig-feed__track {
    display: flex;
    align-items: stretch;
    gap: var(--sig-gap);
    width: 100%;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }

  .sig-feed__slide {
    flex:
      0 0
      calc(
        (
          100% -
          (
            var(--sig-gap) *
            (var(--sig-columns) - 1)
          )
        ) /
        var(--sig-columns)
      );
    min-width: 0;
    margin: 0;
    transition:
      transform 320ms
      cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sig-feed__slide:hover {
    position: relative;
    z-index: 4;
    transform:
      scale(1.055)
      translateY(-4px);
  }

  .sig-feed__item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--sig-radius);
    background: #ece9e3;
    color: #ffffff;
    text-decoration: none;
    isolation: isolate;
    box-shadow:
      0 1px 0
      rgba(0, 0, 0, 0.04);
    transition:
      box-shadow 320ms ease;
  }

  .sig-feed__slide:hover
  .sig-feed__item {
    box-shadow:
      0 18px 42px
      rgba(0, 0, 0, 0.2);
  }

  .sig-feed__item[aria-disabled="true"] {
    cursor: default;
  }

  .sig-feed__media {
    position: absolute;
    inset: 0;
  }

  .sig-feed__media img,
  .sig-feed__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    image-rendering: auto;
    filter:
      grayscale(
        {{ block.settings.grayscale }}%
      );
    transform: none;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    transition:
      filter 320ms ease,
      transform 420ms
      cubic-bezier(0.22, 1, 0.36, 1);
  }

  .sig-feed__item:hover
  .sig-feed__media img,
  .sig-feed__item:hover
  .sig-feed__media video {
    filter: grayscale(0%);
    transform: scale(1.012);
  }

  .sig-feed__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    padding: 18px;
    background:
      linear-gradient(
        to top,
        rgba(0, 0, 0, 0.68) 0%,
        rgba(0, 0, 0, 0.18) 48%,
        rgba(0, 0, 0, 0) 75%
      );
    opacity: 0;
    transform:
      translateY(8px);
    transition:
      opacity 280ms ease,
      transform 320ms ease;
  }

  .sig-feed__item:hover
  .sig-feed__overlay,
  .sig-feed__item:focus-visible
  .sig-feed__overlay {
    opacity: 1;
    transform:
      translateY(0);
  }

  .sig-feed__overlay-content {
    width: 100%;
  }

  .sig-feed__action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding-bottom: 3px;
    border-bottom:
      1px solid
      rgba(255, 255, 255, 0.72);
    font-size: 12px;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .sig-feed__badge {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 3;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;

    min-height: 44px;
    padding: 10px 17px;

    border: 1px solid
      rgba(255, 255, 255, 0.82);
    border-radius: 999px;

    background:
      rgba(255, 255, 255, 0.94);
    color: #1f1f1f;

    font-size: 15px;
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.01em;

    box-shadow:
      0 8px 24px
      rgba(0, 0, 0, 0.18),
      0 2px 6px
      rgba(0, 0, 0, 0.1);

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    transition:
      opacity 220ms ease,
      transform 220ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .sig-feed__item:hover
  .sig-feed__badge {
    opacity: 0;
    transform:
      translateY(5px);
  }

  .sig-feed__heart-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    flex: 0 0 19px;
  }

  .sig-feed__heart-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .sig-feed__badge-text {
    display: inline-block;
    white-space: nowrap;
  }

  .sig-feed__chevron {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }

  .sig-feed__floating-arrow:hover
  .sig-feed__chevron {
    transform: scale(1.08);
  }

  .sig-feed__floating-arrow {
    position: absolute;
    top: 50%;
    z-index: 6;
    width: 54px;
    height: 54px;
    transform:
      translateY(-50%);
  }

  .sig-feed__floating-arrow--previous {
    left: -22px;
  }

  .sig-feed__floating-arrow:not(
    .sig-feed__floating-arrow--previous
  ) {
    right: -22px;
  }

  .sig-feed__floating-arrow:hover {
    transform:
      translateY(
        calc(-50% - 2px)
      );
  }

  .sig-feed__floating-arrow:disabled {
    transform:
      translateY(-50%);
  }

  .sig-feed__skeleton {
    display: grid;
    grid-template-columns:
      repeat(
        var(--sig-columns),
        minmax(0, 1fr)
      );
    gap: var(--sig-gap);
    flex: 0 0 100%;
    width: 100%;
    opacity: 0;
    animation:
      sig-feed-skeleton-show
      1ms linear 150ms forwards;
  }

  .sig-feed__skeleton-item {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--sig-radius);
    background:
      linear-gradient(
        100deg,
        #ece9e3 20%,
        #f6f4f0 38%,
        #ece9e3 56%
      );
    background-size: 220% 100%;
    animation:
      sig-feed-skeleton-shimmer
      1.35s ease-in-out infinite;
  }

  @keyframes sig-feed-skeleton-show {
    to {
      opacity: 1;
    }
  }

  @keyframes sig-feed-skeleton-shimmer {
    from {
      background-position: 120% 0;
    }

    to {
      background-position: -120% 0;
    }
  }

  .sig-feed__message {
    flex: 0 0 100%;
    margin: 0;
  }

  @media screen and (max-width: 1100px) {
    .sig-feed {
      --sig-columns: 3;
    }
  }

  @media screen and (max-width: 768px) {
    .sig-feed {
      --sig-columns: 2;
      --sig-gap:
        {{ block.settings.gap_mobile }}px;

      width: 100%;
      max-width: none;
      padding:
        {{ block.settings.padding_top_mobile }}px
        0
        {{ block.settings.padding_bottom_mobile }}px
        16px;
    }

    .sig-feed__header {
      align-items: center;
      padding-right: 16px;
      margin-bottom: 18px;
    }

    .sig-feed__heading {
      font-size:
        min(
          {{ block.settings.heading_size }}px,
          38px
        );
    }

    .sig-feed__viewport {
      overflow-x: auto;
      overflow-y: visible;
      padding:
        10px
        16px
        18px
        0;
      margin:
        -10px
        0
        -18px;
      scroll-snap-type:
        x mandatory;
      scrollbar-width: none;
      -webkit-overflow-scrolling:
        touch;
    }

    .sig-feed__viewport::-webkit-scrollbar {
      display: none;
    }

    .sig-feed__track {
      width: max-content;
      transform: none !important;
      transition: none !important;
    }

    .sig-feed__slide {
      flex:
        0 0
        min(
          68vw,
          320px
        );
      width:
        min(
          68vw,
          320px
        );
      scroll-snap-align: start;
    }

    .sig-feed__slide:hover {
      transform: none;
    }

    .sig-feed__floating-arrow {
      display: none;
    }

    .sig-feed__overlay {
      opacity: 1;
      transform: none;
      background:
        linear-gradient(
          to top,
