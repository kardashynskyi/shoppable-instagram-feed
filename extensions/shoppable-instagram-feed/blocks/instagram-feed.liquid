    .sig-feed__slide {
      flex:
        0 0
        min(
          78vw,
          310px
        );
      width:
        min(
          78vw,
          310px
        );
    }
  }

  @media (hover: none) {
    .sig-feed__slide:hover {
      transform: none;
    }

    .sig-feed__media img,
    .sig-feed__media video {
      filter:
        grayscale(
          calc(
